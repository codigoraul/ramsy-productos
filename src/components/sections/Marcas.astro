---
import { getLogosClientes } from '../../lib/logosClientes.js'

// Logos y enlaces se editan en WordPress → Logos clientes (imagen destacada, Enlace, Orden).
const logos = await getLogosClientes()

// Rubro que se muestra bajo cada marca (si la marca no está aquí, no se muestra rubro)
const categorias = {
  'makita': 'Herramientas',
  'abb': 'Electrónica',
  'schneider electric': 'Control',
  'phoenix contact': 'Conectividad',
  'endress+hauser': 'Instrumentación',
}

const marcas = logos.map((l) => ({
  nombre: l.nombre,
  categoria: categorias[l.nombre.toLowerCase()] ?? '',
  logo: l.logo,
  url: l.url,
  Tag: l.url ? 'a' : 'div',
}))
---

<section class="py-32 bg-[#F5F5F0]">
  <div class="max-w-[1200px] mx-auto px-8">

    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-20">
      <p class="text-[#F47920] text-sm font-medium uppercase tracking-[0.22em] mb-7">
        Partners
      </p>
      <h2 class="text-[#0E2346] font-semibold mb-7" style="font-size: 42px; line-height: 1.08; letter-spacing: -0.025em;">
        Marcas que representamos
      </h2>
      <p class="text-gray-500 font-light" style="font-size: clamp(1.1rem, 1.4vw, 1.3rem); line-height: 1.7;">
        Trabajamos con los principales fabricantes del mundo en instrumentación y electrónica industrial.
      </p>
    </div>

    <!-- Marcas: tarjetas de logo sin grilla ni bordes -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-x-6 gap-y-14 items-start">
      {marcas.map(marca => (
        <marca.Tag
          href={marca.url || undefined}
          target={marca.url ? '_blank' : undefined}
          rel={marca.url ? 'noopener noreferrer' : undefined}
          class="group flex flex-col items-center gap-5 text-center"
        >
          <div class="flex items-center justify-center" style="height: 104px;">
            <img
              src={marca.logo}
              alt={`Logo ${marca.nombre}`}
              loading="lazy"
              class="rounded-2xl ring-1 ring-black/5 shadow-[0_6px_24px_-8px_rgba(14,35,70,0.25)] transition-all duration-300 group-hover:-translate-y-1 group-hover:shadow-[0_14px_32px_-10px_rgba(14,35,70,0.35)]"
              style="height: 104px; width: auto; max-width: 100%; object-fit: contain;"
            />
          </div>
          <div class="flex flex-col items-center gap-1.5">
            <p class="text-[#0E2346] group-hover:text-[#F47920] font-medium tracking-tight transition-colors" style="font-size: 1.05rem;">
              {marca.nombre}
            </p>
            {marca.categoria && (
              <p class="text-gray-400 text-xs font-light tracking-wider uppercase">
                {marca.categoria}
              </p>
            )}
          </div>
        </marca.Tag>
      ))}
    </div>

    <p class="text-center text-base text-gray-500 font-light mt-12">
      ¿Buscas una marca específica?
      <a href="/contacto" class="text-[#F47920] hover:underline font-medium ml-1">Consúltanos →</a>
    </p>

  </div>
</section>
