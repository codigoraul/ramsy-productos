---
import Layout from '../../layouts/Layout.astro'
import Breadcrumb from '../../components/ui/Breadcrumb.astro'
import { getProductos, getCategorias, formatearPrecio, getImagenProducto } from '../../lib/woocommerce.js'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')

// Trae TODOS los productos (de 100 en 100) para que el filtro por categoría funcione sobre el catálogo completo
let productos = []
for (let page = 1; page <= 20; page++) {
  const lote = await getProductos({ perPage: 100, page })
  productos.push(...lote)
  if (lote.length < 100) break
}
const categorias = await getCategorias()

// Barra compacta: las categorías con más productos van como botones; el resto, en el menú "Más categorías"
const ordenadas = [...(categorias || [])]
  .filter(c => c.slug !== 'sin-categorizar')
  .sort((a, b) => b.count - a.count)
const principales = ordenadas.slice(0, 7)
const restantes = ordenadas.slice(7).sort((a, b) => a.name.localeCompare(b.name, 'es'))
---

<Layout 
  title="Productos" 
  description="Catálogo de productos de instrumentación y electrónica industrial"
>
  <Breadcrumb 
    items={[
      { label: 'Inicio', href: '/' },
      { label: 'Productos' }
    ]}
    title="Productos"
    backgroundImage="https://images.unsplash.com/photo-1581092918056-0c4c3acd3789?w=1600&q=80"
  />

  <!-- Productos -->
  <section class="py-16 bg-white">
    <div class="max-w-[1200px] mx-auto px-10">
      
      <!-- Header -->
      <div class="mb-12">
        <p class="text-[#F47920] text-sm font-medium uppercase tracking-[0.22em] mb-4">
          Catálogo
        </p>
        <h2 class="text-[#0E2346] font-semibold mb-6">
          Nuestros productos
        </h2>
        <p class="text-gray-600 font-light leading-[1.7] max-w-3xl">
          Instrumentación y electrónica industrial de alta precisión para tu empresa.
        </p>
      </div>

      <!-- Filtros por categoría (barra compacta) -->
      {categorias && categorias.length > 0 && (
        <div class="mb-10 pb-6 border-b border-gray-200">
          <div class="flex flex-wrap items-center gap-2">
            <button class="categoria-filter chip is-active" data-categoria="todas">Todas</button>
            {principales.map(cat => (
              <button class="categoria-filter chip" data-categoria={cat.slug}>
                {cat.name} <span class="chip-count">{cat.count}</span>
              </button>
            ))}

            {restantes.length > 0 && (
              <div class="relative" id="mas-categorias">
                <button type="button" id="mas-toggle" class="chip chip-mas" aria-expanded="false" aria-controls="mas-panel">
                  <span id="mas-label">Más categorías</span>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </button>
                <div id="mas-panel" class="mas-panel hidden" role="listbox">
                  {restantes.map(cat => (
                    <button class="categoria-filter mas-item" data-categoria={cat.slug} data-nombre={cat.name}>
                      <span>{cat.name}</span> <span class="chip-count">{cat.count}</span>
                    </button>
                  ))}
                </div>
              </div>
            )}
          </div>
          <p id="resultado-count" class="mt-4 text-sm text-gray-500 font-light"></p>
        </div>
      )}

      <!-- Grid de productos -->
      {productos && productos.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          {productos.map(producto => {
            const precio = formatearPrecio(producto.price)
            const imagen = getImagenProducto(producto)
            const categoriaSlug = (producto.categories || []).map(c => c.slug).join(' ')
            
            return (
              <article 
                class="producto-card group bg-white border border-gray-200 hover:border-[#F47920] transition-all duration-300 hover:shadow-lg"
                data-categorias={categoriaSlug}
              >
                {/* Imagen */}
                <a href={`${base}/productos/${producto.slug}`} class="block bg-[#F5F5F0] p-6 overflow-hidden">
                  <img 
                    src={imagen} 
                    alt={producto.name}
                    class="w-full h-64 object-contain group-hover:scale-105 transition-transform duration-300"
                  />
                </a>

                {/* Info */}
                <div class="p-6">
                  {/* Categoría */}
                  {producto.categories && producto.categories.length > 0 && (
                    <p class="text-[#F47920] text-xs font-medium uppercase tracking-[0.2em] mb-3">
                      {producto.categories[0].name}
                    </p>
                  )}

                  {/* Nombre */}
                  <h3 class="text-[#0E2346] font-semibold mb-3 group-hover:text-[#F47920] transition-colors text-2xl">
                    <a href={`${base}/productos/${producto.slug}`}>
                      {producto.name}
                    </a>
                  </h3>

                  {/* SKU */}
                  {producto.sku && (
                    <p class="text-gray-500 text-sm font-light mb-4">
                      SKU: {producto.sku}
                    </p>
                  )}

                  {/* Precio */}
                  <div class="flex items-center justify-between pt-4 border-t border-gray-100">
                    <div>
                      <p class="text-[#0E2346] font-semibold text-2xl">
                        {precio}
                      </p>
                      <p class="text-gray-400 font-light text-xs">
                        IVA incluido
                      </p>
                    </div>
                    
                    {/* Stock badge */}
                    {producto.stock_status === 'instock' ? (
                      <span class="text-green-600 text-xs font-medium px-3 py-1 bg-green-50 rounded-full">
                        En stock
                      </span>
                    ) : (
                      <span class="text-red-600 text-xs font-medium px-3 py-1 bg-red-50 rounded-full">
                        Sin stock
                      </span>
                    )}
                  </div>

                  {/* Botón */}
                  <a 
                    href={`${base}/productos/${producto.slug}`}
                    class="mt-4 block w-full text-center bg-[#F47920] text-white px-6 py-3 font-medium tracking-wide hover:bg-[#d66a1a] transition-colors"
                  >
                    Ver detalles
                  </a>
                </div>
              </article>
            )
          })}
        </div>
      ) : (
        <div class="text-center py-20">
          <svg class="w-20 h-20 text-gray-300 mx-auto mb-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
          </svg>
          <h3 class="text-[#0E2346] font-semibold mb-3 text-2xl">
            No hay productos disponibles
          </h3>
          <p class="text-gray-600 font-light mb-8">
            Estamos actualizando nuestro catálogo. Vuelve pronto.
          </p>
          <a href="/contacto" class="inline-block bg-[#F47920] text-white px-8 py-3 font-medium tracking-wide hover:bg-[#d66a1a] transition-colors">
            Contáctanos
          </a>
        </div>
      )}

    </div>
  </section>
</Layout>

<style>
  .chip {
    display: inline-flex; align-items: center; gap: .4rem;
    padding: .5rem 1rem; font-size: .9rem; font-weight: 500;
    color: #374151; background: #f3f4f6; border-radius: 9999px;
    transition: background-color .2s, color .2s;
  }
  .chip:hover { background: #e5e7eb; }
  .chip.is-active { background: #F47920; color: #fff; }
  .chip-count { font-size: .75rem; opacity: .6; }
  .chip.is-active .chip-count { opacity: .85; }
  .chip-mas { background: #fff; border: 1px solid #d1d5db; }
  .mas-panel {
    position: absolute; z-index: 30; top: calc(100% + .5rem); left: 0;
    width: 320px; max-height: 340px; overflow-y: auto;
    background: #fff; border: 1px solid #e5e7eb; border-radius: .75rem;
    box-shadow: 0 16px 40px -12px rgba(14,35,70,.25); padding: .5rem;
  }
  .mas-item {
    display: flex; justify-content: space-between; gap: 1rem; width: 100%;
    text-align: left; padding: .55rem .75rem; font-size: .9rem; color: #374151; border-radius: .5rem;
  }
  .mas-item:hover { background: #f3f4f6; }
  .mas-item.is-active { background: #FFF1E6; color: #F47920; font-weight: 600; }
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  const filterButtons = document.querySelectorAll('.categoria-filter')
  const productCards = document.querySelectorAll('.producto-card')
  const toggle = document.getElementById('mas-toggle')
  const panel = document.getElementById('mas-panel')
  const masLabel = document.getElementById('mas-label')
  const resultado = document.getElementById('resultado-count')

  function filtrarProductos(categoria) {
    let activoEnMenu = null
    filterButtons.forEach(btn => {
      const activo = btn.getAttribute('data-categoria') === categoria
      btn.classList.toggle('is-active', activo)
      if (activo && btn.classList.contains('mas-item')) activoEnMenu = btn.getAttribute('data-nombre')
    })

    // El botón "Más categorías" muestra la categoría elegida del menú
    if (toggle && masLabel) {
      masLabel.textContent = activoEnMenu || 'Más categorías'
      toggle.classList.toggle('is-active', !!activoEnMenu)
    }

    let visibles = 0
    productCards.forEach(card => {
      const categorias = (card.getAttribute('data-categorias') || '').split(' ')
      const mostrar = categoria === 'todas' || categorias.includes(categoria)
      card.style.display = mostrar ? 'block' : 'none'
      if (mostrar) visibles++
    })

    if (resultado) {
      resultado.textContent = visibles === 1 ? '1 producto' : `${visibles} productos`
    }
  }

  function cerrarMenu() {
    panel?.classList.add('hidden')
    toggle?.setAttribute('aria-expanded', 'false')
  }

  toggle?.addEventListener('click', (e) => {
    e.stopPropagation()
    const abierto = !panel.classList.toggle('hidden')
    toggle.setAttribute('aria-expanded', String(abierto))
  })
  document.addEventListener('click', (e) => {
    if (!document.getElementById('mas-categorias')?.contains(e.target)) cerrarMenu()
  })
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') cerrarMenu() })

  filterButtons.forEach(button => {
    button.addEventListener('click', () => {
      filtrarProductos(button.getAttribute('data-categoria'))
      cerrarMenu()
    })
  })

  // Categoría inicial desde la URL (?categoria=slug) o todas
  const categoriaInicial = new URLSearchParams(window.location.search).get('categoria')
  filtrarProductos(categoriaInicial || 'todas')
</script>
