---
import '../styles/global.css'
import Header from '../components/layout/Header.astro'
import Footer from '../components/layout/Footer.astro'
import WhatsAppButton from '../components/ui/WhatsAppButton.astro'

interface Props {
  title: string
  description?: string
  /** HTML crudo que genera Yoast SEO (viene de yoast_head en la API de WooCommerce) */
  yoastHead?: string
  /** URL canónica de la página (ej: https://ramsy.cl/productos/sensor-de-flujo) */
  canonical?: string
  /** URL de imagen para og:image de fallback */
  ogImage?: string
}

const {
  title,
  description = 'Instrumentación y electrónica industrial',
  yoastHead,
  canonical,
  ogImage,
} = Astro.props

const pageTitle  = title ? `${title} | RAMSY` : 'RAMSY | Instrumentación y Electrónica Industrial'
const canonicalUrl = canonical ?? Astro.url.href
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {yoastHead ? (
      // ── Yoast SEO activo: inyectar el <head> generado por Yoast ──────────
      // Yoast incluye: <title>, meta description, canonical, og:*, twitter:*, schema.org
      // Solo dejamos charset y viewport (arriba) y los recursos que Yoast no maneja.
      <Fragment set:html={yoastHead} />
    ) : (
      // ── Fallback cuando Yoast no está disponible aún ─────────────────────
      <>
        <title>{pageTitle}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalUrl} />
        <meta property="og:type"        content="website" />
        <meta property="og:title"       content={pageTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url"         content={canonicalUrl} />
        <meta property="og:site_name"   content="RAMSY" />
        <meta property="og:locale"      content="es_CL" />
        {ogImage && <meta property="og:image" content={ogImage} />}
        <meta name="twitter:card"        content="summary_large_image" />
        <meta name="twitter:title"       content={pageTitle} />
        <meta name="twitter:description" content={description} />
        {ogImage && <meta name="twitter:image" content={ogImage} />}
      </>
    )}

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;600;700&display=block" rel="stylesheet" />
  </head>
  <body class="bg-white text-gray-900">
    <!-- Overlay de mantenimiento: oculto por defecto, se muestra si WordPress reporta el modo activo -->
    <div id="ramsy-maintenance-overlay" style="display:none; position:fixed; inset:0; z-index:9999; background:#0E2346; color:#fff; align-items:center; justify-content:center; flex-direction:column; text-align:center; padding:2rem;">
      <img src="/logo-blanco.png" alt="RAMSY" style="width:160px; margin-bottom:2rem;" />
      <h1 style="font-size:1.8rem; font-weight:600; margin-bottom:1rem;">Sitio en mantenimiento</h1>
      <p style="max-width:32rem; font-weight:300; opacity:0.85; line-height:1.6;">
        Estamos realizando mejoras en nuestra tienda online. Volveremos a estar disponibles muy pronto.
        Para consultas urgentes, contáctanos directamente por WhatsApp.
      </p>
    </div>

    <div id="ramsy-site-content">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
      <WhatsAppButton />
    </div>

    <script is:inline>
      (function () {
        // Bypass: agregar ?ramsy_bypass=1 a la URL una vez para seguir viendo el sitio normal
        // mientras el mantenimiento está activo (útil para revisar antes de publicar).
        var params = new URLSearchParams(window.location.search)
        if (params.get('ramsy_bypass') === '1') {
          localStorage.setItem('ramsy_bypass_maintenance', '1')
        }
        if (localStorage.getItem('ramsy_bypass_maintenance') === '1') return

        fetch('https://ramsy.cl/admin/wp-json/ramsy/v1/mantenimiento?t=' + Date.now())
          .then(function (r) { return r.json() })
          .then(function (data) {
            if (data && data.enabled) {
              document.getElementById('ramsy-maintenance-overlay').style.display = 'flex'
              document.getElementById('ramsy-site-content').style.display = 'none'
            }
          })
          .catch(function () {
            // Si falla la consulta (ej. WordPress caído), no bloqueamos el sitio.
          })
      })()
    </script>
  </body>
</html>