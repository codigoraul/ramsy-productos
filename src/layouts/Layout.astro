---
import '../styles/global.css'
import Header from '../components/layout/Header.astro'
import Footer from '../components/layout/Footer.astro'
import WhatsAppButton from '../components/ui/WhatsAppButton.astro'

interface Props {
  title: string
  description?: string
  /** HTML crudo que genera Yoast SEO (viene de yoast_head en la API de WooCommerce) */
  yoastHead?: string
  /** URL canónica de la página (ej: https://ramsy.cl/productos/sensor-de-flujo) */
  canonical?: string
  /** URL de imagen para og:image de fallback */
  ogImage?: string
}

const {
  title,
  description = 'Instrumentación y electrónica industrial',
  yoastHead,
  canonical,
  ogImage,
} = Astro.props

const pageTitle  = title ? `${title} | RAMSY` : 'RAMSY | Instrumentación y Electrónica Industrial'
const canonicalUrl = canonical ?? Astro.url.href
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {yoastHead ? (
      // ── Yoast SEO activo: inyectar el <head> generado por Yoast ──────────
      // Yoast incluye: <title>, meta description, canonical, og:*, twitter:*, schema.org
      // Solo dejamos charset y viewport (arriba) y los recursos que Yoast no maneja.
      <Fragment set:html={yoastHead} />
    ) : (
      // ── Fallback cuando Yoast no está disponible aún ─────────────────────
      <>
        <title>{pageTitle}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalUrl} />
        <meta property="og:type"        content="website" />
        <meta property="og:title"       content={pageTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url"         content={canonicalUrl} />
        <meta property="og:site_name"   content="RAMSY" />
        <meta property="og:locale"      content="es_CL" />
        {ogImage && <meta property="og:image" content={ogImage} />}
        <meta name="twitter:card"        content="summary_large_image" />
        <meta name="twitter:title"       content={pageTitle} />
        <meta name="twitter:description" content={description} />
        {ogImage && <meta name="twitter:image" content={ogImage} />}
      </>
    )}

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;600;700&display=block" rel="stylesheet" />
  </head>
  <body class="bg-white text-gray-900">
    <!-- Overlay de mantenimiento: oculto por defecto, se muestra si WordPress reporta el modo activo -->
    <div id="ramsy-maintenance-overlay" style="display:none; position:fixed; inset:0; z-index:9999; background:linear-gradient(160deg, #0E2346 0%, #133065 100%); color:#fff; align-items:center; justify-content:center; flex-direction:column; text-align:center; padding:2rem; font-family: 'IBM Plex Sans', sans-serif;">
      <img src="/logo-blanco.png" alt="RAMSY" style="width:150px; margin-bottom:2.5rem;" />

      <div style="width:56px; height:56px; border-radius:50%; background:rgba(244,121,32,0.15); display:flex; align-items:center; justify-content:center; margin-bottom:1.75rem;">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#F47920" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M12 6v6l4 2"></path>
        </svg>
      </div>

      <h1 style="font-size:1.9rem; font-weight:600; margin-bottom:1rem; letter-spacing:-0.01em;">Estamos en mantenimiento</h1>
      <p style="max-width:30rem; font-weight:300; opacity:0.8; line-height:1.7; font-size:1.05rem; margin-bottom:2.25rem;">
        Estamos realizando mejoras en nuestra tienda online para atenderte mejor.
        Volveremos a estar disponibles muy pronto.
      </p>

      <a
        href="https://wa.me/56981739992?text=Hola%2C%20vi%20que%20la%20web%20est%C3%A1%20en%20mantenimiento%20y%20quisiera%20consultar"
        target="_blank"
        rel="noopener noreferrer"
        style="display:inline-flex; align-items:center; gap:0.6rem; background:#F47920; color:#fff; padding:0.85rem 1.75rem; border-radius:999px; font-weight:500; text-decoration:none; font-size:0.95rem; transition:background 0.2s;"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.46 17.5 2 12.04 2zm5.8 14.14c-.24.68-1.19 1.25-1.95 1.41-.52.11-1.2.2-3.48-.75-2.92-1.21-4.8-4.16-4.95-4.35-.14-.19-1.18-1.57-1.18-3 0-1.42.75-2.13 1.02-2.42.27-.29.58-.36.78-.36.19 0 .39 0 .56.01.18.01.42-.07.66.5.24.58.83 2.01.9 2.15.07.15.12.32.02.51-.09.19-.14.31-.28.48-.14.16-.29.36-.42.49-.14.13-.28.28-.12.55.16.28.72 1.19 1.55 1.93 1.06.95 1.96 1.24 2.24 1.38.28.14.44.12.6-.07.16-.19.68-.79.87-1.06.18-.27.36-.22.6-.13.24.09 1.55.73 1.82.86.27.13.44.19.51.3.07.11.07.63-.17 1.3z"/>
        </svg>
        Escríbenos por WhatsApp
      </a>
    </div>

    <div id="ramsy-site-content">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
      <WhatsAppButton />
    </div>

    <script is:inline>
      (function () {
        // Bypass: agregar ?ramsy_bypass=1 a la URL una vez para seguir viendo el sitio normal
        // mientras el mantenimiento está activo (útil para revisar antes de publicar).
        var params = new URLSearchParams(window.location.search)
        if (params.get('ramsy_bypass') === '1') {
          localStorage.setItem('ramsy_bypass_maintenance', '1')
        }
        if (localStorage.getItem('ramsy_bypass_maintenance') === '1') return

        fetch('https://ramsy.cl/admin/wp-json/ramsy/v1/mantenimiento?t=' + Date.now())
          .then(function (r) { return r.json() })
          .then(function (data) {
            if (data && data.enabled) {
              document.getElementById('ramsy-maintenance-overlay').style.display = 'flex'
              document.getElementById('ramsy-site-content').style.display = 'none'
            }
          })
          .catch(function () {
            // Si falla la consulta (ej. WordPress caído), no bloqueamos el sitio.
          })
      })()
    </script>
  </body>
</html>